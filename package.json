{
  "name": "doc-vibeforma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Documentation site for VibeForma — local voice dictation for Windows",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/build-llms.mjs && node scripts/clear-astro-cache.mjs",
    "build": "astro build",
    "build:timings": "astro build --timings",
    "preview": "astro preview",
    "llms": "node scripts/build-llms.mjs",
    "verify": "node scripts/verify-build.mjs",
    "verify:all": "node scripts/verify-build.mjs --all",
    "giscus:ids": "node scripts/giscus-ids.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "gsap": "3.13.0",
    "lenis": "1.1.14",
    "sharp": "0.35.5",
    "starlight-blog": "0.30.2",
    "starlight-giscus": "^1.2.0",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.3",
    "starlight-links-validator": "^0.27.0",
    "starlight-llms-txt": "^0.12.0",
    "starlight-page-feedback": "^0.1.0",
    "three": "0.160.0"
  }
}
