  starfield,
  planet,
  wave,
  organic,
  city,
  water,
  silhouette,
};

const installParts = [
  'irm ',
  'https://raw.githubusercontent.com/FormaMindPro/vibeforma/main/install.ps1',
  ' | iex',
];
const installCommand = installParts.join('');

