    <nav class="nav">
      <a href="#dust" class="logo glitch"><img class="logo-mark" src="/brand/vf-mark-line-white.svg" alt="" width="31" height="31" decoding="async">VibeForma<span>{t.brandTag}</span></a>
      <div class="nav-links">
        <a href="#worlds">{t.nav.where}</a>
        <a href="#life">{t.nav.trust}</a>
        <a href="#flight">{t.nav.plan}</a>
        <a href={docHref('/introduction/')}>{t.nav.docs}</a>
        <a href={community} target="_blank" rel="noopener noreferrer">{t.nav.community}</a>
        <span class="nav-lang" role="group" aria-label={t.langSwitch.label}>
          <span class="is-current" aria-current="true">{t.langSwitch.current}</span>
          <i aria-hidden="true">/</i>
