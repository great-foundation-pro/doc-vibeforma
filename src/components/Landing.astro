const t = isRu ? ru : en;

const footerDocs = [
  { label: isRu ? 'Введение' : 'Introduction', href: docHref('/introduction/') },
  { label: isRu ? 'Установка' : 'Installation', href: docHref('/installation/') },
  { label: isRu ? 'Использование' : 'Usage', href: docHref('/usage/') },
  { label: isRu ? 'Конфиденциальность' : 'Privacy', href: docHref('/privacy/') },
  { label: isRu ? 'Решение проблем' : 'Troubleshooting', href: docHref('/troubleshooting/') },
];

const footerMore = [
  { label: isRu ? 'Блог' : 'Blog', href: docHref('/blog/'), external: false },
  { label: isRu ? 'Логи' : 'Logs', href: docHref('/logs/'), external: false },
  { label: 'GitHub', href: 'https://github.com/FormaMindPro/vibeforma', external: true },
];
---

<!doctype html>
<html lang={isRu ? 'ru' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f8f5ec" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VibeForma" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>

    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={isRu ? '/ru/' : '/'} aria-label="VibeForma">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <rect x="1" y="1" width="18" height="18" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
            <path
              d="M5.8 12.4V10.6M10 14V6.6M14.2 12.4V9.2"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"></path>
            <circle class="mark-dot" cx="14.9" cy="5.4" r="1.3"></circle>
          </svg>
          <span>VibeForma</span>
        </a>

        <nav class="site-nav" aria-label={t.navLabel}>
          <a href={docHref('/introduction/')}>{t.nav.docs}</a>
          <a href={docHref('/blog/')}>{t.nav.blog}</a>
          <a href={docHref('/logs/')}>{t.nav.logs}</a>
          <a href="https://github.com/FormaMindPro/vibeforma" target="_blank" rel="noopener noreferrer">{t.nav.github}</a>
          <div class="lang-switch" role="group" aria-label={t.langSwitchLabel}>
            {
              isRu ? (
                <>
                  <a href="/" hreflang="en" lang="en" aria-label={t.switchToEnglish}>
                    EN
                  </a>
                  <span class="current" aria-current="true">
                    RU
                  </span>
                </>
              ) : (
                <>
                  <span class="current" aria-current="true">
                    EN
                  </span>
                  <a href="/ru/" hreflang="ru" lang="ru" aria-label={t.switchToRussian}>
                    RU
                  </a>
                </>
              )
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="wrap hero-inner">
          <div>
            <p class="eyebrow">{t.eyebrow}</p>
            <h1>VibeForma</h1>
            <p class="tagline">{t.tagline}</p>
            <p class="lead">{t.lead}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#install">{t.ctaPrimary} <span class="arrow" aria-hidden="true">↓</span></a>
              <a class="btn btn-secondary" href={docHref('/introduction/')}>
                {t.ctaSecondary} <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
            <p class="meta-row">
              {t.meta.map((item) => <span>{item}</span>)}
            </p>
          </div>

          <div class="sheet" aria-hidden="true">
            <div class="sheet-head">
              <span class="sheet-live">{t.sheetLive}</span>
              <span class="hotkey">Ctrl+Alt+Space</span>
            </div>
            <div class="wave">
              {waveHeights.map((height, index) => <span style={`--h:${height}px;--i:${index}`}></span>)}
            </div>
            <p class="sheet-text">{t.sheetPhrase}</p>
            <p class="sheet-caption">{t.sheetCaption}</p>
          </div>
        </div>
      </section>

      <section class="section" id="what">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">{t.whatEyebrow}</p>
            <h2>{t.whatTitle}</h2>
            <p class="section-lead">{t.whatLead}</p>
          </div>
          <ol class="steps">
            {
              t.steps.map((step) => (
                <li>
                  <span class="step-n">{step.n}</span>
                  <h3 class="step-title">{step.title}</h3>
                  <p class="step-text">{step.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="note">{t.note}</p>
        </div>
      </section>

      <section class="section" id="features">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">{t.featuresEyebrow}</p>
            <h2>{t.featuresTitle}</h2>
            <p class="section-lead">{t.featuresLead}</p>
          </div>
          <div class="feature-grid">
            {
              t.features.map((feature) => (
                <article class="feature">
                  <h3>{feature.title}</h3>
                  <p>{feature.text}</p>
                </article>
              ))
            }
          </div>
          <div class="settings-strip">
            <span class="settings-label">{t.settingsLabel}</span>
            {t.settingsTabs.map((tab) => <span class="settings-tab">{tab}</span>)}
          </div>
        </div>
      </section>

      <section class="section" id="install">
        <div class="wrap">
          <div class="install-panel">
            <div>
              <p class="eyebrow">{t.installEyebrow}</p>
              <h2>{t.installTitle}</h2>
              <p class="requirements">{t.requirements}</p>
              <div class="code-row">
                <code>{t.installCommand}</code>
                <button
                  class="copy-btn"
                  type="button"
                  data-copy
                  data-label={t.copyLabel}
                  data-copied={t.copiedLabel}>{t.copyLabel}</button>
              </div>
              <a class="install-link" href={docHref('/installation/')}>{t.installLink} →</a>
            </div>
            <div>
              <ul class="install-list">
                {t.installDetails.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="section" id="explore">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">{t.exploreEyebrow}</p>
            <h2>{t.exploreTitle}</h2>
          </div>
          <div class="explore-grid">
            {
              t.explore.map((card) => (
                <a
                  class="explore-card"
                  href={card.href}
                  target={card.external ? '_blank' : undefined}
                  rel={card.external ? 'noopener noreferrer' : undefined}>
                  <span class="card-top">
                    <h3>{card.title}</h3>
                    <span class="go" aria-hidden="true">
                      {card.external ? '↗' : '→'}
                    </span>
                  </span>
                  <p>{card.text}</p>
                </a>
              ))
            }
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a class="footer-brand" href={isRu ? '/ru/' : '/'}>
              <svg width="16" height="16" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                <rect x="1" y="1" width="18" height="18" rx="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
                <path
                  d="M5.8 12.4V10.6M10 14V6.6M14.2 12.4V9.2"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"></path>
                <circle class="mark-dot" cx="14.9" cy="5.4" r="1.3"></circle>
              </svg>
              <span>VibeForma</span>
            </a>
            <p class="footer-tagline">{t.tagline}</p>
          </div>

          <nav aria-label={t.footerDocsLabel}>
            <h2 class="footer-heading">{t.footerDocsLabel}</h2>
            <ul class="footer-list">
              {footerDocs.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            </ul>
          </nav>

          <nav aria-label={t.footerMoreLabel}>
            <h2 class="footer-heading">{t.footerMoreLabel}</h2>
            <ul class="footer-list">
              {
                footerMore.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
        </div>

        <div class="footer-bottom">
          <p>© 2026 FormaMindPro</p>
          <p>{t.footerNote}</p>
        </div>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll('[data-copy]').forEach(function (button) {
        button.addEventListener('click', function () {
          var row = button.closest('.code-row');
          var code = row ? row.querySelector('code') : null;
          if (!code || !navigator.clipboard) return;
          navigator.clipboard.writeText(code.textContent || '').then(function () {
            var original = button.getAttribute('data-label') || button.textContent;
            button.textContent = button.getAttribute('data-copied') || original;
            window.setTimeout(function () {
              button.textContent = original;
            }, 1800);
          });
        });
      });
    </script>
  </body>
</html>
