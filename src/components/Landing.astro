---
import '../styles/landing.css';

interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const isRu = locale === 'ru';
const base = isRu ? '/ru' : '';
const docHref = (path: string) => `${base}${path}`;
const canonical = isRu ? 'https://vibeforma.pro/ru/' : 'https://vibeforma.pro/';

const waveHeights = [10, 22, 38, 30, 16, 44, 34, 20, 12, 28, 46, 36, 18, 10, 24, 40, 30, 14, 8, 18, 30, 22, 12, 6];

const en = {
