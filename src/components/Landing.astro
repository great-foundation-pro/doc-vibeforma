import city from '../assets/landing/06-city.jpg';
import water from '../assets/landing/featured-water.jpg';
import silhouette from '../assets/landing/trust-silhouette.jpg';

interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const isRu = locale === 'ru';
const base = isRu ? '/ru' : '';
const docHref = (path: string) => `${base}${path}`;
const canonical = isRu ? 'https://vibeforma.pro/ru/' : 'https://vibeforma.pro/';
const repo = 'https://github.com/FormaMindPro/vibeforma';
const forma = 'https://formamind.pro';
const community = 'https://formamind.pro/community/';

const media = {
  nebula,
  starfield,
  planet,
  wave,
  organic,
  city,
  water,
  silhouette,
};

const installParts = [
  'irm ',
  'https://raw.githubusercontent.com/FormaMindPro/vibeforma/main/install.ps1',
  ' | iex',
];
const installCommand = installParts.join('');

