        <button id="sndToggle" class="snd-toggle" aria-pressed="false" title={t.nav.sound}>
          <i></i>{t.nav.sound} <em>{t.js.soundOff}</em>
        </button>
        <a href="#return" class="nav-ticket" data-magnetic=""><span>{t.nav.install}</span></a>
        <button class="nav-burger" id="navBurger" type="button" aria-expanded="false" aria-controls="navMenu" aria-label={t.nav.menu}>
          <span></span><span></span>
        </button>
      </div>
      <div class="nav-menu" id="navMenu">
        <a href="#ignition">{t.hero.secondary}</a>
        <a href="#worlds">{t.nav.where}</a>
        <a href="#life">{t.nav.trust}</a>
        <a href="#flight">{t.nav.plan}</a>
        <button id="sndToggleMobile" class="snd-toggle nav-menu-sound" type="button" aria-pressed="false">
          <i></i>{t.nav.sound} <em>{t.js.soundOff}</em>
        </button>
        <p class="nav-menu-label">{t.footer.docsLabel}</p>
        <div class="nav-menu-small">
          {t.footer.docs.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <p class="nav-menu-label">{t.footer.projectLabel}</p>
        <div class="nav-menu-small">
          <a href={docHref('/blog/')}>{t.footer.project[1].label}</a>
          <a href={docHref('/logs/')}>{t.footer.project[2].label}</a>
          <a href={community} target="_blank" rel="noopener noreferrer">{t.nav.community}</a>
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <p class="nav-menu-label">{t.footer.langLabel}</p>
        <div class="nav-menu-small">
          <span>{t.langSwitch.current}</span>
          <a href={t.langSwitch.otherHref} hreflang={isRu ? 'en' : 'ru'} lang={isRu ? 'en' : 'ru'}>{t.langSwitch.other}</a>
        </div>
      </div>
    </nav>

    <div id="rail" aria-hidden="true">
      {
        t.epochs.map((epoch, index) => (
          <div class:list={['rail-item', { 'is-active': index === 0 }]} data-target={epoch.id}>
            <span>{epoch.name}</span><i></i>
          </div>
        ))
      }
    </div>

    <main>

      <section class="section hero" id="dust" data-shape="0" data-bg="#04060a" data-glow="#5be9ff" data-epoch={t.epochs[0].name}>
        <div class="wrap hero-grid">
          <div class="hero-center">
            <p class="eyebrow" data-reveal=""><i class="pulse-dot"></i>{t.hero.eyebrow}</p>

            <h1 class="hero-title glitch" id="heroTitle">{t.hero.title}</h1>
            <p class="hero-sub" id="heroSub">{t.hero.sub}</p>

            <p class="hero-copy" data-reveal="" set:html={t.hero.copy}></p>

            <div class="hero-actions" data-reveal="">
              <a href="#return" class="btn btn-primary" data-magnetic=""><span>{t.hero.primary}</span></a>
              <a href="#ignition" class="btn btn-secondary" data-magnetic=""><span>{t.hero.secondary}</span></a>
            </div>
          </div>

          <div class="hero-meta" data-reveal="">
            <div class="meta-block">
              <span class="meta-label">{t.hero.metaLeftLabel}</span>
              <span class="meta-value" set:html={t.hero.metaLeft}></span>
            </div>
            <div class="scroll-cue"><i></i>{t.hero.scroll}</div>
            <div class="meta-block right">
              <span class="meta-label">{t.hero.metaRightLabel}</span>
              <span class="meta-value" set:html={t.hero.metaRight}></span>
            </div>
          </div>
        </div>
