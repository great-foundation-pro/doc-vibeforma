interface Props {
  locale?: 'en' | 'ru';
}

const { locale = 'en' } = Astro.props;
const isRu = locale === 'ru';
const base = isRu ? '/ru' : '';
const docHref = (path: string) => `${base}${path}`;
const canonical = isRu ? 'https://vibeforma.pro/ru/' : 'https://vibeforma.pro/';
const repo = 'https://github.com/FormaMindPro/vibeforma';
const forma = 'https://formamind.pro';
const community = 'https://formamind.pro/community/';

const media = {
