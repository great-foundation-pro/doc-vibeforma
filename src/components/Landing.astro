  ],
  installLink: 'Руководство по установке',
  exploreEyebrow: 'Смотреть дальше',
  exploreTitle: 'Документация, заметки и исходный код',
  explore: [
    {
      title: 'Документация',
      text: 'Введение, установка, использование, конфиденциальность и решение проблем.',
      href: docHref('/introduction/'),
      external: false,
    },
    { title: 'Блог', text: 'Заметки о продукте и проекте.', href: docHref('/blog/'), external: false },
    { title: 'Логи', text: 'Журнал разработки этого сайта.', href: docHref('/logs/'), external: false },
    {
      title: 'GitHub',
      text: 'Исходный код, README и установочные скрипты.',
      href: 'https://github.com/FormaMindPro/vibeforma',
