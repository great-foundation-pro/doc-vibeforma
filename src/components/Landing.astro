const t = isRu ? ru : en;
const installHref = docHref('/installation/');
const ogImage = `https://vibeforma.pro/og/${isRu ? 'landing-ru' : 'landing-en'}.jpg`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://vibeforma.pro/#website',
      url: 'https://vibeforma.pro/',
      name: 'VibeForma',
      inLanguage: ['en', 'ru'],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'VibeForma',
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Windows 10, Windows 11',
      url: canonical,
      downloadUrl: repo,
      license: 'https://opensource.org/licenses/MIT',
      description: t.description,
      inLanguage: t.lang,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href="https://vibeforma.pro/" />
    <link rel="alternate" hreflang="ru" href="https://vibeforma.pro/ru/" />
    <link rel="alternate" hreflang="x-default" href="https://vibeforma.pro/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#04060a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="VibeForma" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={isRu ? 'ru_RU' : 'en_US'} />
    <meta property="og:locale:alternate" content={isRu ? 'en_US' : 'ru_RU'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={isRu ? 'VibeForma — голосовой ввод для Windows' : 'VibeForma — voice input for Windows'}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.title} />
    <meta name="twitter:description" content={t.description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#dust">{t.skip}</a>

    <canvas id="entity" aria-hidden="true"></canvas>

    <div id="scrim" aria-hidden="true"></div>
    <div id="grain" aria-hidden="true"></div>
    <div class="cursor" id="cursor" aria-hidden="true"></div>
    <div class="cursor-hint" id="cursorHint" aria-hidden="true">{t.hint}</div>

    <div id="preloader">
      <div class="pre-count"><span id="preNum">00</span><em>%</em></div>
      <div class="pre-label" set:html={t.preloaderLabel}></div>
      <div class="pre-bar"><span id="preBar"></span></div>
    </div>

    <div id="chrono" aria-hidden="true">
      <span class="chrono-label" id="chronoEpoch">{t.epochs[0].name}</span>
      <span class="chrono-year" id="chronoYear">{t.hud.form} · 0%</span>
    </div>

    <div id="telemetry" aria-hidden="true">
      <span id="telemCoords">0.50 · 0.50</span>
      <span class="telem-status"><i id="telemDot"></i><em id="telemState">{t.hud.stable}</em></span>
    </div>

    <nav class="nav">
      <a href="#dust" class="logo glitch">VibeForma<span>{t.brandTag}</span></a>
      <div class="nav-links">
        <a href="#worlds">{t.nav.where}</a>
        <a href="#life">{t.nav.trust}</a>
        <a href="#flight">{t.nav.plan}</a>
        <a href={docHref('/introduction/')}>{t.nav.docs}</a>
        <a href={community} target="_blank" rel="noopener noreferrer">{t.nav.community}</a>
        <span class="nav-lang" role="group" aria-label={t.langSwitch.label}>
          <span class="is-current" aria-current="true">{t.langSwitch.current}</span>
          <i aria-hidden="true">/</i>
          <a href={t.langSwitch.otherHref} hreflang={isRu ? 'en' : 'ru'} lang={isRu ? 'en' : 'ru'} aria-label={t.langSwitch.otherName}>{t.langSwitch.other}</a>
        </span>
        <button id="sndToggle" class="snd-toggle" aria-pressed="false" title={t.nav.sound}>
          <i></i>{t.nav.sound} <em>{t.js.soundOff}</em>
        </button>
        <a href="#return" class="nav-ticket" data-magnetic=""><span>{t.nav.install}</span></a>
        <button class="nav-burger" id="navBurger" type="button" aria-expanded="false" aria-controls="navMenu" aria-label={t.nav.menu}>
          <span></span><span></span>
        </button>
      </div>
      <div class="nav-menu" id="navMenu">
        <a href="#ignition">{t.hero.secondary}</a>
        <a href="#worlds">{t.nav.where}</a>
        <a href="#life">{t.nav.trust}</a>
        <a href="#flight">{t.nav.plan}</a>
        <button id="sndToggleMobile" class="snd-toggle nav-menu-sound" type="button" aria-pressed="false">
          <i></i>{t.nav.sound} <em>{t.js.soundOff}</em>
        </button>
        <p class="nav-menu-label">{t.footer.docsLabel}</p>
        <div class="nav-menu-small">
          {t.footer.docs.map((link) => <a href={link.href}>{link.label}</a>)}
        </div>
        <p class="nav-menu-label">{t.footer.projectLabel}</p>
        <div class="nav-menu-small">
          <a href={docHref('/blog/')}>{t.footer.project[1].label}</a>
          <a href={docHref('/logs/')}>{t.footer.project[2].label}</a>
          <a href={community} target="_blank" rel="noopener noreferrer">{t.nav.community}</a>
          <a href={repo} target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <p class="nav-menu-label">{t.footer.langLabel}</p>
        <div class="nav-menu-small">
          <span>{t.langSwitch.current}</span>
          <a href={t.langSwitch.otherHref} hreflang={isRu ? 'en' : 'ru'} lang={isRu ? 'en' : 'ru'}>{t.langSwitch.other}</a>
        </div>
      </div>
    </nav>

    <div id="rail" aria-hidden="true">
      {
        t.epochs.map((epoch, index) => (
          <div class:list={['rail-item', { 'is-active': index === 0 }]} data-target={epoch.id}>
            <span>{epoch.name}</span><i></i>
          </div>
        ))
      }
    </div>

    <main>

      <section class="section hero" id="dust" data-shape="0" data-bg="#04060a" data-glow="#5be9ff" data-epoch={t.epochs[0].name}>
        <div class="wrap hero-grid">
          <div class="hero-center">
            <p class="eyebrow" data-reveal=""><i class="pulse-dot"></i>{t.hero.eyebrow}</p>

            <h1 class="hero-title glitch" id="heroTitle">{t.hero.title}</h1>
            <p class="hero-sub" id="heroSub">{t.hero.sub}</p>

            <p class="hero-copy" data-reveal="" set:html={t.hero.copy}></p>

            <div class="hero-actions" data-reveal="">
              <a href="#return" class="btn btn-primary" data-magnetic=""><span>{t.hero.primary}</span></a>
              <a href="#ignition" class="btn btn-secondary" data-magnetic=""><span>{t.hero.secondary}</span></a>
            </div>
          </div>

          <div class="hero-meta" data-reveal="">
            <div class="meta-block">
              <span class="meta-label">{t.hero.metaLeftLabel}</span>
              <span class="meta-value" set:html={t.hero.metaLeft}></span>
            </div>
            <div class="scroll-cue"><i></i>{t.hero.scroll}</div>
            <div class="meta-block right">
              <span class="meta-label">{t.hero.metaRightLabel}</span>
              <span class="meta-value" set:html={t.hero.metaRight}></span>
            </div>
          </div>
        </div>
      </section>

      <section class="section statement" id="ignition" data-shape="1" data-bg="#0a0710" data-glow="#ff8a5b" data-epoch={t.epochs[1].name}>
        <div class="statement-inner">
          <p class="kicker">{t.statement.kicker}</p>
          <div class="statement-lines" id="statementLines">
            {t.statement.lines.map((line) => <p class="s-line" set:html={line} />)}
          </div>
        </div>
      </section>

      <section class="section epochs" id="worlds" data-shape="2" data-bg="#070910" data-glow="#c9a06a" data-epoch={t.epochs[2].name}>
        <div class="epochs-pin">
          <div class="epochs-head wrap">
            <div>
              <p class="eyebrow">{t.worlds.eyebrow}</p>
              <h2 class="h2 split glitch" set:html={t.worlds.title}></h2>
            </div>
            <p class="epochs-note">{t.worlds.note}</p>
          </div>

          <div class="epochs-track" id="epochsTrack">
            {
              t.worlds.cards.map((card, index) => (
                <article class="epoch-card">
                  <figure class="epoch-img" data-img-reveal="">
                    <Image src={t.worlds.images[index]} alt={card.alt} loading="lazy" widths={[480, 800]} sizes="(max-width: 900px) 78vw, 420px" />
                  </figure>
                  <div class="epoch-body">
                    <span class="epoch-no">{card.no}</span>
                    <span class="epoch-when">{card.tag}</span>
                    <h3>{card.title}</h3>
                    <p>{card.text}</p>
                  </div>
                </article>
              ))
            }
          </div>

          <div class="epochs-progress"><span id="epochsBar"></span></div>
        </div>
      </section>

      <section class="section featured" id="water" data-shape="3" data-bg="#04080d" data-glow="#4fb6e0" data-epoch={t.epochs[3].name}>
        <div class="wrap featured-grid">
          <div class="featured-lead">
            <p class="kicker" data-reveal="">{t.featured.kicker}</p>
            <h2 class="h2 split glitch" set:html={t.featured.title}></h2>
            <p class="featured-copy" data-reveal="">{t.featured.copy}</p>
            <div class="featured-stats" data-reveal="">
              {
                t.featured.stats.map((stat) => (
                  <div><span>{stat.label}</span><strong>{stat.value}</strong></div>
                ))
              }
            </div>
          </div>

          <figure class="featured-img" data-img-reveal="" data-speed="1.1">
            <Image src={t.featured.src} alt={t.featured.alt} loading="lazy" widths={[520, 780, 1024]} sizes="(max-width: 900px) 88vw, 480px" />
            <figcaption><span>{t.featured.captionNo}</span>{t.featured.caption}</figcaption>
          </figure>
        </div>
      </section>

      <section class="section visit" id="life" data-shape="4" data-bg="#050a0a" data-glow="#5bf0d8" data-epoch={t.epochs[4].name}>
        <div class="wrap visit-grid">
          <div class="visit-lead">
            <p class="kicker" data-reveal="">{t.trust.kicker}</p>
            <h2 class="h2 split glitch" set:html={t.trust.title}></h2>
            <p class="visit-copy" data-reveal="">{t.trust.copy}</p>
            <figure class="visit-img" data-img-reveal="">
              <Image src={t.trust.src} alt={t.trust.alt} loading="lazy" widths={[640, 960, 1280]} sizes="(max-width: 900px) 90vw, 640px" />
              <figcaption><span>{t.trust.figNo}</span>{t.trust.figCaption}</figcaption>
            </figure>
          </div>

          <div class="visit-card" data-reveal="">
            <h3>{t.trust.cardTitle}</h3>
            <div class="visit-rows">
              {
                t.trust.rows.map((row) => (
                  <div class="visit-row"><span>{row.label}</span><strong>{row.value}</strong></div>
                ))
              }
            </div>
            <a href="#return" class="btn btn-primary btn-wide" data-magnetic=""><span>{t.trust.cta}</span></a>
          </div>
        </div>
      </section>

      <section class="section program" id="flight" data-shape="5" data-bg="#0a070c" data-glow="#e08ab8" data-epoch={t.epochs[5].name}>
        <div class="wrap">
          <p class="kicker" data-reveal="">{t.plan.kicker}</p>
          <h2 class="h2 split glitch" set:html={t.plan.title}></h2>

          <div class="program-list">
            {
              t.plan.rows.map((row) => (
                <a
                  class="program-row"
                  href={row.href}
                  data-reveal=""
                  target={row.external ? '_blank' : undefined}
                  rel={row.external ? 'noopener noreferrer' : undefined}
                >
                  <span class="p-when">{row.when}</span>
                  <span class="p-name">{row.name}</span>
                  <span class="p-desc">{row.desc}</span>
                  <span class="p-arrow">→</span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section class="section manifesto" id="signal" data-shape="6" data-bg="#0a0812" data-glow="#a78bfa" data-epoch={t.epochs[6].name}>
        <div class="wrap manifesto-wrap">
          <p class="kicker" data-reveal="">{t.manifesto.kicker}</p>
          <div class="manifesto-lines" id="manifestoLines">
            {t.manifesto.lines.map((line) => <p class="m-line" set:html={line} />)}
          </div>
          <p class="manifesto-credit" data-reveal=""><span>{t.manifesto.creditLabel}</span><strong>{t.manifesto.credit}</strong></p>
        </div>
      </section>

      <section class="section final" id="return" data-shape="7" data-bg="#030408" data-glow="#5b9fe0" data-epoch={t.epochs[7].name}>
        <div class="wrap final-wrap">
          <p class="kicker" data-reveal="">{t.final.kicker}</p>
          <h2 class="final-title split glitch" set:html={t.final.title}></h2>
          <p class="final-copy" data-reveal="">{t.final.copy}</p>
          <div class="final-actions" data-reveal="">
            <a href={installHref} class="btn btn-primary" data-magnetic=""><span>{t.final.primary}</span></a>
            <a href="#flight" class="btn btn-secondary" data-magnetic=""><span>{t.final.secondary}</span></a>
          </div>
          <div class="install-row" data-reveal="">
            <code>
              {installParts.map((part) => <span>{part}</span>)}
            </code>
            <button
              type="button"
              class="install-copy"
              data-copy={installCommand}
              data-label-copy={t.final.copyLabel}
              data-label-copied={t.final.copiedLabel}
            >
              {t.final.copyLabel}
            </button>
          </div>
          <p class="install-note" data-reveal="">{t.final.note}</p>
        </div>
      </section>

      <footer class="footer">
        <div class="wrap footer-wrap">
          <div class="footer-top">
            <a href="#dust" class="footer-brand">VibeForma<em>{t.footer.tagline}</em></a>
            <div class="footer-cols">
              <div class="footer-col">
                <h4>{t.footer.productLabel}</h4>
                {t.footer.product.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
              <div class="footer-col">
                <h4>{t.footer.trustLabel}</h4>
                {
                  t.footer.trust.map((link) => (
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  ))
                }
              </div>
              <div class="footer-col">
                <h4>{t.footer.docsLabel}</h4>
                {t.footer.docs.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
              <div class="footer-col">
                <h4>{t.footer.projectLabel}</h4>
                {
                  t.footer.project.map((link) => (
                    <a
                      href={link.href}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noopener noreferrer' : undefined}
                    >
                      {link.label}
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="footer-bottom">
            <span>{t.footer.bottomLeft}</span>
            <span>{t.footer.bottomRight}</span>
            <span class="footer-lang">
              <span aria-current="true">{t.langSwitch.current}</span>
              {' / '}
              <a href={t.langSwitch.otherHref} hreflang={isRu ? 'en' : 'ru'} lang={isRu ? 'en' : 'ru'}>{t.langSwitch.other}</a>
            </span>
          </div>
        </div>
      </footer>

    </main>

    <script type="application/json" id="vf-i18n" set:html={JSON.stringify(t.js)}></script>
    <script>
      import '../scripts/landing.js';
    </script>
  </body>
</html>
