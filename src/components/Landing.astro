    <script is:inline>
// card-202 patch: modal wiring for the flight function cards (classic script, ASCII only).
(function () {
  'use strict';
  var OPEN = 'is-open';
  var LOCK = 'vf-lock';
  var openModal = null;
  var lastTrigger = null;
  var modals = {};
  var backdrops = {};

  document.querySelectorAll('.vf-modal').forEach(function (m) {
    var key = m.getAttribute('data-modal');
    if (key && !modals[key]) { modals[key] = m; }
  });
  document.querySelectorAll('.vf-backdrop').forEach(function (b) {
    var key = b.getAttribute('data-backdrop');
    if (key) {
      if (!backdrops[key]) { backdrops[key] = b; }
      b.addEventListener('click', function () { closeModal(); });
    }
  });

  function openModalFn(key, trigger) {
    var m = modals[key];
    if (!m || openModal === m) { return; }
    if (openModal) { closeModal(); }
    openModal = m;
    lastTrigger = trigger || null;
    m.classList.add(OPEN);
    if (backdrops[key]) { backdrops[key].classList.add(OPEN); }
    document.body.classList.add(LOCK);
    var target = m.querySelector('.vf-close') || m;
    if (typeof target.focus === 'function') { target.focus(); }
  }

  function closeModal() {
    if (!openModal) { return; }
    var key = openModal.getAttribute('data-modal');
    openModal.classList.remove(OPEN);
    if (backdrops[key]) { backdrops[key].classList.remove(OPEN); }
    document.body.classList.remove(LOCK);
    if (lastTrigger && typeof lastTrigger.focus === 'function') { lastTrigger.focus(); }
    openModal = null;
    lastTrigger = null;
  }

  // card-206 patch: catalog cards open the same modals (click + keyboard).
  document.querySelectorAll('button.program-row[data-modal], article.catalog-card[data-modal]').forEach(function (t) {
    t.addEventListener('click', function () {
      openModalFn(t.getAttribute('data-modal'), t);
    });
    if (t.tagName !== 'BUTTON') {
      t.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openModalFn(t.getAttribute('data-modal'), t);
        }
      });
    }
  });
  document.querySelectorAll('.vf-modal [data-close]').forEach(function (c) {
    c.addEventListener('click', function () { closeModal(); });
  });

  document.addEventListener('keydown', function (e) {
    if (!openModal) { return; }
    if (e.key === 'Escape') {
      e.preventDefault();
      closeModal();
      return;
    }
    if (e.key === 'Tab') {
      var items = openModal.querySelectorAll('button, a[href]');
      if (!items.length) { return; }
      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
})();
    </script>
  </body>
