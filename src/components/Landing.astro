  : 'VibeForma \u2014 voice input for Windows';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://vibeforma.pro/#website',
      url: 'https://vibeforma.pro/',
      name: 'VibeForma',
