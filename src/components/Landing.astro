  requirements: 'Windows 10/11 x64 · Python 3.10+ in PATH',
  installCommand: 'irm https://raw.githubusercontent.com/FormaMindPro/vibeforma/main/install.ps1 | iex',
  copyLabel: 'Copy',
  copiedLabel: 'Copied',
  installDetails: [
    'Installs to %LOCALAPPDATA%\\VibeForma.',
    'The installer accepts -Model, -Target, -Cpu, -DryRun, -NoRun.',
    'The recognition model is downloaded once; after that, dictation works offline.',
  ],
  installLink: 'Installation guide',
  exploreEyebrow: 'Explore',
  exploreTitle: 'Documentation, notes and source',
  explore: [
    {
      title: 'Documentation',
      text: 'Introduction, installation, usage, privacy and troubleshooting.',
      href: docHref('/introduction/'),
      external: false,
    },
    { title: 'Blog', text: 'Notes about the product and the project.', href: docHref('/blog/'), external: false },
    { title: 'Logs', text: 'The development journal of this site.', href: docHref('/logs/'), external: false },
    {
      title: 'GitHub',
      text: 'Source code, README and install scripts.',
