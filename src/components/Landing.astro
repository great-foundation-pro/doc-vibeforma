  navLabel: 'Основная навигация',
  langSwitchLabel: 'Язык',
  switchToRussian: 'Переключиться на русский',
  switchToEnglish: 'Переключиться на английский',
  eyebrow: 'Локальная голосовая диктовка · Windows 10/11',
  tagline: 'From voice vibe to sharp form',
  lead: 'Нажмите горячую клавишу, говорите — текст появляется там, где стоит курсор. Распознавание идёт на вашем компьютере, а не в облаке.',
  meta: ['Около 99 языков', 'Работает офлайн', 'Лицензия MIT'],
  ctaPrimary: 'Установить',
  ctaSecondary: 'Открыть документацию',
  sheetLive: 'Диктовка',
  sheetPhrase: '«Заметки ко встрече в четверг.»',
  sheetCaption: 'Текст появляется у курсора',
