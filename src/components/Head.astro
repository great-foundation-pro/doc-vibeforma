---
import Default from '@astrojs/starlight/components/Head.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// One preview per page; generated by card-178 (Seedream 5.5 art + VibeForma typography).
const images: Record<string, string> = {
  '/introduction': 'introduction-en.jpg',
  '/installation': 'installation-en.jpg',
  '/usage': 'usage-en.jpg',
  '/privacy': 'privacy-en.jpg',
  '/troubleshooting': 'troubleshooting-en.jpg',
  '/blog': 'blog-en.jpg',
  '/blog/2026-11-21-documentation-site': 'post-en.jpg',
  '/blog/authors/formamindpro': 'author-en.jpg',
  '/logs': 'logs-en.jpg',
  '/logs/2026-11-21-start': 'log-start-en.jpg',
  '/ru/introduction': 'introduction-ru.jpg',
  '/ru/installation': 'installation-ru.jpg',
  '/ru/usage': 'usage-ru.jpg',
  '/ru/privacy': 'privacy-ru.jpg',
  '/ru/troubleshooting': 'troubleshooting-ru.jpg',
  '/ru/blog': 'blog-ru.jpg',
  '/ru/blog/2026-11-21-documentation-site': 'post-ru.jpg',
  '/ru/blog/authors/formamindpro': 'author-ru.jpg',
  '/ru/logs': 'logs-ru.jpg',
  '/ru/logs/2026-11-21-start': 'log-start-ru.jpg',
};

const file = images[path] ?? 'landing-en.jpg';
const image = `https://vibeforma.pro/og/${file}`;
const alt = path.startsWith('/ru')
  ? 'VibeForma — локальная голосовая диктовка для Windows'
  : 'VibeForma — local voice dictation for Windows';
---

<Default {...Astro.props} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={image} />
