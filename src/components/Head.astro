---
import fs from 'node:fs';
import path from 'node:path';
import Default from '@astrojs/starlight/components/Head.astro';

const route = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isRu = pathname === '/ru' || pathname.startsWith('/ru/');
const lang = isRu ? 'ru' : 'en';
const pagePath = isRu ? pathname.replace(/^\/ru/, '') || '/' : pathname;
const entry = route.entry;
const title = entry?.data.title ?? 'VibeForma';

// starlight-blog does not expose a description for the blog index or an
// author page, so both would inherit the site description. Give them their
// own copy; every other page keeps the description from its frontmatter.
const seoDescriptions: Record<string, Record<string, string>> = {
  '/blog': {
    en: 'Notes on building VibeForma, local voice dictation for Windows, and this documentation site.',
    ru: '\u0417\u0430\u043c\u0435\u0442\u043a\u0438 \u043e VibeForma \u2014 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0439 \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0435 \u0434\u043b\u044f Windows \u2014 \u0438 \u044d\u0442\u043e\u043c \u0441\u0430\u0439\u0442\u0435 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u0446\u0438\u0438.',
  },
  '/blog/authors/formamindpro': {
    en: 'FormaMindPro is the project behind VibeForma, local voice dictation for Windows.',
    ru: 'FormaMindPro \u2014 \u043f\u0440\u043e\u0435\u043a\u0442, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0435\u043b\u0430\u0435\u0442 VibeForma, \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0443\u044e \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443 \u0434\u043b\u044f Windows.',
  },
};
const seoDescription = seoDescriptions[pagePath]?.[lang];
if (seoDescription) {
  for (const tag of route.head) {
    if (tag.tag !== 'meta') continue;
    if (tag.attrs?.name === 'description' || tag.attrs?.property === 'og:description') {
      tag.attrs.content = seoDescription;
    }
  }
}
const headDescription = route.head.find(
  (tag) => tag.tag === 'meta' && tag.attrs?.name === 'description',
)?.attrs?.content;
const description = entry?.data.description || seoDescription || headDescription || '';
const isNotFound = pagePath === '/404' || title === '404';
const isBlogPost = /^\/blog\/[^/]+$/.test(pagePath) && !pagePath.startsWith('/blog/authors/');
const isLogEntry = /^\/logs\/[^/]+$/.test(pagePath);
const isEntry = isBlogPost || isLogEntry;
const isDocs = !isEntry && !isNotFound && pagePath !== '/wishlist' &&
  !pagePath.startsWith('/blog') && !pagePath.startsWith('/logs');

// One preview per page. Docs slugs come from the page path; the journal and
// the wishlist carry their own preview. Every generated file is checked before
// use, so a missing image falls back to the landing preview instead of a 404.
function previewSlug(value: string): string {
  if (value === '/blog') return 'blog';
  if (value.startsWith('/blog/authors/')) return 'author';
  if (isBlogPost) return value === '/blog/2026-11-21-documentation-site' ? 'post' : 'blog';
  if (value === '/logs') return 'logs';
  if (isLogEntry) return value === '/logs/2026-11-21-start' ? 'log-start' : 'logs';
  if (value === '/wishlist') return 'wishlist';
  if (value === '/') return 'landing';
  return value.replace(/^\//, '');
}

const ogDir = path.join(process.cwd(), 'public', 'og');
let file = `${previewSlug(pagePath)}-${lang}.jpg`;
if (!fs.existsSync(path.join(ogDir, file))) file = `landing-${lang}.jpg`;
const origin = Astro.site ?? new URL('https://vibeforma.pro');
const image = new URL(`/og/${file}`, origin).href;
const canonical = new URL(pathname === '/' ? '/' : `${pathname}/`, origin).href;
const alt = `VibeForma \u2014 ${title}`;
const hasStructuredData = route.head.some(
  (tag) => tag.tag === 'script' && tag.attrs?.type === 'application/ld+json',
);

// Starlight emits og:locale as a bare language code and og:type as article on
// every route. Replace both with the Open Graph contract and keep a single
// copy of each tag.
const head = route.head;
for (let index = head.length - 1; index >= 0; index -= 1) {
  const tag = head[index];
  const property = tag.tag === 'meta' ? tag.attrs?.property : undefined;
  if (property === 'og:locale' || property === 'og:type') head.splice(index, 1);
}

const ogType = isEntry ? 'article' : 'website';
const jsonLdType = isBlogPost ? 'BlogPosting' : isEntry ? 'Article' : isDocs ? 'TechArticle' : 'WebPage';
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': jsonLdType,
  name: title,
  headline: isDocs || isEntry ? title : undefined,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  image,
  inLanguage: lang,
  isPartOf: {
    '@type': 'WebSite',
    name: 'VibeForma',
    url: 'https://vibeforma.pro/',
  },
  publisher: {
    '@type': 'Organization',
    name: 'FormaMindPro',
    url: 'https://formamind.pro/',
  },
  author: {
    '@type': 'Organization',
    name: 'FormaMindPro',
    url: 'https://formamind.pro/',
  },
};
const published = entry?.data.date;
const publishedIso = isEntry && published ? new Date(published).toISOString() : undefined;
if (publishedIso) jsonLd.datePublished = publishedIso;
---

<script is:inline>
  // The docs are dark by default. Seed the choice before Starlight reads it;
  // a visitor's stored pick (dark, light or auto) is never overwritten.
  (() => {
    try {
      const key = 'starlight-theme';
      if (localStorage.getItem(key) === null && !localStorage.getItem('vf-theme-defaulted')) {
        localStorage.setItem(key, 'dark');
        localStorage.setItem('vf-theme-defaulted', '1');
      }
    } catch (e) {}
  })();
</script>
<script is:inline>
  // giscus picks its frame theme from the OS by default; the page may carry a
  // stored theme instead. Align the widget before it loads and follow later
  // theme switches through the widget's own setConfig message.
  (() => {
    const origin = 'https://giscus.app';
    const theme = () => {
      const value = document.documentElement.dataset.theme;
      return value === 'light' || value === 'dark' ? value : '';
    };
    const sync = () => {
      const value = theme();
      if (!value) return;
      const script = document.querySelector('script[src^="https://giscus.app/client.js"]');
      if (script && script.dataset.theme !== value) script.dataset.theme = value;
      const frame = document.querySelector('iframe.giscus-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: value } } }, origin);
      }
    };
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };
    new MutationObserver(schedule).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
      childList: true,
      subtree: true,
    });
    schedule();
  })();
</script>
<Default {...Astro.props} />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<meta
  name="robots"
  content={isNotFound
    ? 'noindex, follow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta name="author" content="FormaMindPro" />
<meta property="og:locale" content={isRu ? 'ru_RU' : 'en_US'} />
<meta property="og:locale:alternate" content={isRu ? 'en_US' : 'ru_RU'} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={alt} />
{publishedIso && <meta property="article:published_time" content={publishedIso} />}
{!isNotFound && !hasStructuredData && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />
)}
<script is:inline>
  // Documentation screenshots load eagerly: a page carries one or two of them,
  // and in some embedded browsers a lazy image below the fold stays a blank
  // frame even after scrolling into view.
  addEventListener('DOMContentLoaded', () => {
    document
      .querySelectorAll('.sl-markdown-content img[loading="lazy"]')
      .forEach((img) => {
        img.loading = 'eager';
      });
  });
</script>
