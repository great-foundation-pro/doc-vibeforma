---
import Default from '@astrojs/starlight/components/Head.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// One preview per page; generated by card-178 (Seedream 5.5 art + VibeForma typography).
const images: Record<string, string> = {
  '/introduction': 'introduction-en.jpg',
  '/installation': 'installation-en.jpg',
  '/usage': 'usage-en.jpg',
  '/privacy': 'privacy-en.jpg',
  '/troubleshooting': 'troubleshooting-en.jpg',
  '/blog': 'blog-en.jpg',
  '/blog/2026-11-21-documentation-site': 'post-en.jpg',
  '/blog/authors/formamindpro': 'author-en.jpg',
  '/logs': 'logs-en.jpg',
  '/logs/2026-11-21-start': 'log-start-en.jpg',
  '/ru/introduction': 'introduction-ru.jpg',
  '/ru/installation': 'installation-ru.jpg',
  '/ru/usage': 'usage-ru.jpg',
  '/ru/privacy': 'privacy-ru.jpg',
  '/ru/troubleshooting': 'troubleshooting-ru.jpg',
  '/ru/blog': 'blog-ru.jpg',
  '/ru/blog/2026-11-21-documentation-site': 'post-ru.jpg',
  '/ru/blog/authors/formamindpro': 'author-ru.jpg',
  '/ru/logs': 'logs-ru.jpg',
  '/ru/logs/2026-11-21-start': 'log-start-ru.jpg',
};

const file = images[path] ?? 'landing-en.jpg';
const image = `https://vibeforma.pro/og/${file}`;
const alt = path.startsWith('/ru')
  ? 'VibeForma — локальная голосовая диктовка для Windows'
  : 'VibeForma — local voice dictation for Windows';
---

<script is:inline>
  // The docs are dark by default. Seed the choice before Starlight reads it;
  // a visitor's stored pick (dark, light or auto) is never overwritten.
  (() => {
    try {
      const key = 'starlight-theme';
      if (localStorage.getItem(key) === null && !localStorage.getItem('vf-theme-defaulted')) {
        localStorage.setItem(key, 'dark');
        localStorage.setItem('vf-theme-defaulted', '1');
      }
    } catch (e) {}
  })();
</script>
<script is:inline>
  // giscus picks its frame theme from the OS by default; the page may carry a
  // stored theme instead. Align the widget before it loads and follow later
  // theme switches through the widget's own setConfig message.
  (() => {
    const origin = 'https://giscus.app';
    const theme = () => {
      const value = document.documentElement.dataset.theme;
      return value === 'light' || value === 'dark' ? value : '';
    };
    const sync = () => {
      const value = theme();
      if (!value) return;
      const script = document.querySelector('script[src^="https://giscus.app/client.js"]');
      if (script && script.dataset.theme !== value) script.dataset.theme = value;
      const frame = document.querySelector('iframe.giscus-frame');
      if (frame && frame.contentWindow) {
        frame.contentWindow.postMessage({ giscus: { setConfig: { theme: value } } }, origin);
      }
    };
    let queued = false;
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        sync();
      });
    };
    new MutationObserver(schedule).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
      childList: true,
      subtree: true,
    });
    schedule();
  })();
</script>
<Default {...Astro.props} />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={alt} />
<meta name="twitter:image" content={image} />
<script is:inline>
  // Documentation screenshots load eagerly: a page carries one or two of them,
  // and in some embedded browsers a lazy image below the fold stays a blank
  // frame even after scrolling into view.
  addEventListener('DOMContentLoaded', () => {
    document
      .querySelectorAll('.sl-markdown-content img[loading="lazy"]')
      .forEach((img) => {
        img.loading = 'eager';
      });
  });
</script>
